# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
PORT=8000
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_db
DB_MIN_CONN=2
DB_MAX_CONN=10
DB_TIMEOUT=30

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration
LOG_LEVEL=INFO

# ─── Dropbox Integration ──────────────────────────────────────────────────────
# Option A — Short-lived access token (development only, expires in a few hours)
DROPBOX_ACCESS_TOKEN=sl.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B — OAuth2 Refresh Token (RECOMMENDED for production — never expires)
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# How long to keep folder listings in the PostgreSQL cache (default: 3600 = 1 hour)
DROPBOX_CACHE_TTL_SECONDS=3600
